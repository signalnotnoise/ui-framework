<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ConsumerProject)" />
    <Compile Include="../WorkspaceComparison/LayoutProbe.cs" Link="LayoutProbe.cs" />
  </ItemGroup>
  <Target Name="RequireConsumerProject" BeforeTargets="PrepareForBuild" Condition="'$(ConsumerProject)' == ''">
    <Error Text="Pass -p:ConsumerProject=the Lab Feedback WPF.csproj path." />
  </Target>
</Project>
